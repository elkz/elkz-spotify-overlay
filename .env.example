# Copy this file to .env and fill it in. Never commit .env to GitHub.

# From your app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The https address this runs at. The Spotify app's redirect URI must be this + /callback
PUBLIC_URL=https://music.example.com

# Any long password. You type it once at /login so nobody else can connect their Spotify.
SETUP_PASSWORD=

# Where it listens. nginx forwards your domain to this.
HOST=127.0.0.1
PORT=8787

# How often to ask Spotify what's playing, in milliseconds (only while an overlay is open)
POLL_MS=2500
